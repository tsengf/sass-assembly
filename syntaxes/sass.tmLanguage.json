{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SASS Assembly",
	"scopeName": "source.sass.assembly",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#instructions"
		},
		{
			"include": "#labels"
		},
		{
			"include": "#predicates"
		},
		{
			"include": "#registers"
		}
	],
	"repository": {
		"comments": {
            "match": ";.*$",
            "name": "comment.line.semicolon.assembly"
		},
	    "constants": {
		    "match": "\\b(0x[a-fA-F0-9]+|[0-9]+h?|[01]+b)\\b",
		    "name": "constant.numeric.assembly"
		},
	    "instructions": {
		    "match": "\\b(?i)(BRA|BSSY|BSYNC|C2SR|CALL|CCTL|EXIT|IADD3|IMAD|ISETP|LDC|LDG|LEPC|MOV|NOP|S2R|SHF|STG|UIADD3|ULDC|ULOP3|VIADD)\\b",
		    "name": "keyword.control keyword.control.assembly"
		},
		"labels": {
			"match": "\\.L_x_[0-9]+",
			"name": "entity.name.label.assembly"
		},
	    "predicates": {
		    "match": "\\b(?i)(PT|P[0-9])\\b",
		    "name": "variable.register.assembly"
		},
	    "registers": {
		    "match": "\\b(?i)(RZ|R[0-9]{1,2})\\b",
		    "name": "variable.register.assembly"
		}
	}
}