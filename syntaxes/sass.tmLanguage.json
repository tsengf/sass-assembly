{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SASS Assembly",
	"scopeName": "source.sass.assembly",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#instructions"
		},
		{
			"include": "#registers"
		},
		{
			"include": "#constants"
		}
	],
	"repository": {
		"comments": {
            "match": ";.*$",
            "name": "comment.line.semicolon.assembly"
		},
	    "instructions": {
		    "match": "\\b(?i)(BRA|NOP|LDG|STG|sub|inc|dec|jmp|call|ret)\\b",
		    "name": "keyword.control keyword.control.assembly"
		},
	    "registers": {
		    "match": "\\b(?i)(eax|ebx|ecx|edx|esp|ebp|esi|edi)\\b",
		    "name": "variable.register.assembly"
		},
	    "constants": {
		    "match": "\\b(0x[a-fA-F0-9]+|[0-9]+h?|[01]+b)\\b",
		    "name": "constant.numeric.assembly"
		}
	}
}