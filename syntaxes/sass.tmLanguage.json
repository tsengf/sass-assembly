{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SASS Assembly",
	"scopeName": "source.sass.assembly",
	"fileTypes": ["sass-assembly"],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#instructions"
		},
		{
			"include": "#labels"
		},
		{
			"include": "#registers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.sass",
					"match": "//[^\\n]*"
				},
				{
					"name": "comment.block.sass",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.numeric.hex.sass",
					"match": "(?i)(?<![\\w.])0[x][0-9a-f]+\\b"
				},
				{
					"name": "constant.numeric.decimal.sass",
					"match": "(?i)(?<![\\w.])[0-9]+\\b"
				}
			]
		},
		"directives": {
			"patterns": [
				{
					"name": "keyword.directive.sass",
					"match": "(?i)(?<![\\w.])(\\.align|\\.byte|\\.dword|\\.global|\\.other|\\.type|\\.section|\\.sectionflags|\\.short|\\.size|\\.tkinfo|\\.weak|\\.word|\\.zero)\\b"
				}
			]
		},
	    "instructions": {
			"patterns": [
				{
					"name": "keyword.instruction.arithmetic.sass",
					"match": "(?i)(?<![\\w.])(add|dadd|dmul|fadd|ffma|fmul|hfma2|iadd3|imad|mufu|redux|uiadd3|uimad|ushf|viadd|viadddmnmxb)\\b"
				},
				{
					"name": "keyword.instruction.bitwise.sass",
					"match": "(?i)(?<![\\w.])(and|brev|flo|lop3|plop3|popc|prmt|shf|shfl|ulop3|uprmt)\\b"
				},
				{
					"name": "keyword.instruction.collective.sass",
					"match": "(?i)(?<![\\w.])(elect|endcollective|match)\\b"
				},
				{
					"name": "keyword.instruction.comparison.sass",
					"match": "(?i)(?<![\\w.])(fsetp|isetp|uisetp|vote|voteu)\\b"
				},
				{
					"name": "keyword.instruction.control.sass",
					"match": "(?i)(?<![\\w.])(bra|bssy|call|exit|lepc|ret)\\b"
				},
				{
					"name": "keyword.instruction.conversion.sass",
					"match": "(?i)(?<![\\w.])(f2f|f2i|i2f)\\b"
				},
				{
					"name": "keyword.instruction.misc.sass",
					"match": "(?i)(?<![\\w.])(cctl|nop|yield|utmacmdflush)\\b"
				},
				{
					"name": "keyword.instruction.movement.sass",
					"match": "(?i)(?<![\\w.])(c2sr|cs2r|discard|fsel|ld|ldc|ldg|ldgsts|ldl|lds|lea|mov|p2r|r2ur|sel|st|stg|stl|sts|s2r|s2ur|ublkcp|ublkpf|uldc|ulea|umov|usel|viadd)\\b"
				},
				{
					"name": "keyword.instruction.synchronization.sass",
					"match": "(?i)(?<![\\w.])(arrives|bar|bsync|depbar|fence|membar|syncs|warpsync|yield)\\b"
				}
			]
		},
		"labels": {
			"patterns": [
			  {
				"name": "entity.name.section.sass",
				"match": "(?<![\\w.])\\.L_[A-Za-z0-9_]+(?::)?"
			  }
			]
		},
		"registers": {
			"patterns": [
				{
					"name": "entity.name.class.register.sass",
					"match": "(?i)(?<![\\w.])(rz|r[0-9]{1,3})\\b"
				},
				{
					"name": "entity.name.class.register.barrier.sass",
					"match": "(?i)(?<![\\w.])(b[0-9])\\b"
				},
				{
					"name": "entity.name.class.register.predicate.sass",
					"match": "(?i)(?<![\\w.])(pt|p[0-9])\\b"
				},
				{
					"name": "entity.name.class.register.special.sass",
					"match": "(?i)(?<![\\w.])(srz|sr_tid.x|sr_tid.y|sr_tid.z|sr_ctaid.x|sr_cgactaid|sr_clocklo|sr_laneid|sr_swinhi|sr_virtualsmid)\\b"
				},
				{
					"name": "entity.name.class.register.uniform.sass",
					"match": "(?i)(?<![\\w.])(urz|ur[0-9]{1,2})\\b"
				}
			]
		}
	}
}