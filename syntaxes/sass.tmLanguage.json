{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SASS Assembly",
	"scopeName": "source.sass.assembly",
	"fileTypes": ["sass-assembly"],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#instructions"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.sass",
					"match": "//.*$",
				},
				{
					"name": "comment.block.sass",
					"begin": "/\\*",
					"end": "\\*/",
				}
			]
		},
	    "instructions": {
			"patterns": [
				{
					"name": "keyword.instruction.arithmetic.sass",
					"match": "\\b(?i)(add)\\b",
				},
				{
					"name": "keyword.instruction.comparison.sass",
					"match": "\\b(?i)(set)\\b",
				},
				{
					"name": "keyword.instruction.logic.sass",
					"match": "\\b(?i)(and)\\b",
				},
				{
					"name": "keyword.instruction.movement.sass",
					"match": "\\b(?i)(mov)\\b",
				},
				{
					"name": "keyword.instruction.control.sass",
					"match": "\\b(?i)(bra)\\b",
				},
				{
					"name": "keyword.instruction.misc.sass",
					"match": "\\b(?i)(nop)\\b",
				}
			]
		}
	}
}