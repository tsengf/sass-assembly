{
  "name": "sass",
  "displayName": "SASS Assembly",
  "description": "Syntax highlighting for NVIDIA SASS assembly. Associates *.sass with language \"sass-assembly\" so it is not opened as CSS Sass. To use indented CSS Sass again, set files.associations for *.sass to \"sass\" in settings.",
  "publisher": "local-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsengf/sass-assembly.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "check": "node scripts/validate-grammar.js",
    "test": "npm run check && node --test tests/*.test.js",
    "package": "npm test && node scripts/validate-package.js && vsce package --no-dependencies"
  },
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.sass": "sass-assembly"
      }
    },
    "languages": [
      {
        "id": "sass-assembly",
        "aliases": [
          "SASS Assembly",
          "sass-assembly"
        ],
        "extensions": [
          ".sass"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sass-assembly",
        "scopeName": "source.sass.assembly",
        "path": "./syntaxes/sass.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "jsonc-parser": "3.3.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
